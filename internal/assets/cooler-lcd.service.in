[Unit]
Description=Cooler LCD panel sensor feed (5131:2007)
Documentation=file:@BIN@
After=graphical-session.target
PartOf=graphical-session.target
# A broken configuration is permanent: cooler-lcd exits 2 for those, and this
# bound stops systemd retrying it forever.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=@BIN@
# on-failure, not always: a clean exit (Ctrl-C, panel blanked) must stay stopped.
# Transient problems such as an unplugged cooler exit 1 and are retried.
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
